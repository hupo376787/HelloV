<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HelloV.Desktop</AssemblyName>
    <RootNamespace>HelloV.Desktop</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelloV.Core\HelloV.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.osx.x64" Version="4.13.0.20260627" />
    <PackageReference Include="OpenCvSharp4.runtime.osx.arm64" Version="4.13.0.20260627" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude stale copies left by extracting this project over an older version. -->
    <Content Remove="Models\YOLOv10n_gestures.onnx" />
    <Content Remove="Models\YOLOv10x_gestures.onnx" />
    <None Remove="Models\YOLOv10n_gestures.onnx" />
    <None Remove="Models\YOLOv10x_gestures.onnx" />

    <!-- One source model under repository-root Models, linked beside the desktop executable. -->
    <Content Include="$(HelloVModelsDirectory)/YOLOv10n_gestures.onnx"
             Link="YOLOv10n_gestures.onnx"
             Condition="Exists('$(HelloVModelsDirectory)/YOLOv10n_gestures.onnx')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(HelloVModelsDirectory)/YOLOv10x_gestures.onnx"
             Link="YOLOv10x_gestures.onnx"
             Condition="Exists('$(HelloVModelsDirectory)/YOLOv10x_gestures.onnx')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\HelloV.Core\Languages\*.json"
             Link="Languages\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app-icon.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\app-icon.icns"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
