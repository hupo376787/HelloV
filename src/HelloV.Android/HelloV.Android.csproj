<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HelloV.Android</AssemblyName>
    <RootNamespace>HelloV.Android</RootNamespace>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ApplicationId>com.example.hellov</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Either YOLOv10n_gestures.onnx or YOLOv10x_gestures.onnx may be packaged. -->
    <AndroidAsset Update="Assets\YOLOv10n_gestures.onnx"
                  Condition="Exists('Assets\YOLOv10n_gestures.onnx')" />
    <AndroidAsset Update="Assets\YOLOv10x_gestures.onnx"
                  Condition="Exists('Assets\YOLOv10x_gestures.onnx')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelloV.Core\HelloV.Core.csproj" />
    <PackageReference Include="Avalonia.Android" Version="12.1.0" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.6.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1.1" />
  </ItemGroup>
</Project>
