<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HelloV.Android</AssemblyName>
    <RootNamespace>HelloV.Android</RootNamespace>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ApplicationId>com.xiaowei.hellov</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude stale copies left under Android/Assets by older project versions. -->
    <AndroidAsset Remove="Assets\YOLOv10n_gestures.onnx" />
    <AndroidAsset Remove="Assets\YOLOv10x_gestures.onnx" />

    <!-- Link the one repository-root model into the APK asset root. -->
    <AndroidAsset Include="$(HelloVModelsDirectory)/YOLOv10n_gestures.onnx"
                  Link="YOLOv10n_gestures.onnx"
                  Condition="Exists('$(HelloVModelsDirectory)/YOLOv10n_gestures.onnx')" />
    <AndroidAsset Include="$(HelloVModelsDirectory)/YOLOv10x_gestures.onnx"
                  Link="YOLOv10x_gestures.onnx"
                  Condition="Exists('$(HelloVModelsDirectory)/YOLOv10x_gestures.onnx')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelloV.Core\HelloV.Core.csproj" />
    <PackageReference Include="Avalonia.Android" Version="12.1.0" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Core" Version="1.6.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Camera2" Version="1.6.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Camera.Lifecycle" Version="1.6.1.1" />

    <!-- Keep the AndroidX Lifecycle family on one version to avoid NU1608 conflicts. -->
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.11.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" Version="2.11.0.1" />
  </ItemGroup>
</Project>
