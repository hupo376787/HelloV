<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--
    AvaloniaMainActivity in Avalonia 12 derives from AppCompatActivity.
    The Android theme therefore must inherit from Theme.AppCompat.
  -->
  <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
    <item name="android:windowNoTitle">true</item>
    <item name="windowActionModeOverlay">true</item>
    <item name="android:fontFamily">sans</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:statusBarColor">#090A0F</item>
    <item name="android:navigationBarColor">#090A0F</item>
    <item name="android:windowBackground">#090A0F</item>
    <item name="colorAccent">#5B8CFF</item>
  </style>
</resources>
