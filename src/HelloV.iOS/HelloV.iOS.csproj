<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HelloV.iOS</AssemblyName>
    <RootNamespace>HelloV.iOS</RootNamespace>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationTitle>HelloV</ApplicationTitle>
    <ApplicationId>com.example.hellov</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AppIcon>AppIcon</AppIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelloV.Core\HelloV.Core.csproj" />
    <PackageReference Include="Avalonia.iOS" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ImageAsset Include="Assets.xcassets\AppIcon.appiconset\Contents.json" />

    <!-- Link the same repository-root model into the iOS application bundle root. -->
    <BundleResource Include="$(HelloVModelsDirectory)/YOLOv10n_gestures.onnx"
                    Link="YOLOv10n_gestures.onnx"
                    LogicalName="YOLOv10n_gestures.onnx"
                    Condition="Exists('$(HelloVModelsDirectory)/YOLOv10n_gestures.onnx')" />
    <BundleResource Include="$(HelloVModelsDirectory)/YOLOv10x_gestures.onnx"
                    Link="YOLOv10x_gestures.onnx"
                    LogicalName="YOLOv10x_gestures.onnx"
                    Condition="Exists('$(HelloVModelsDirectory)/YOLOv10x_gestures.onnx')" />
  </ItemGroup>
</Project>
